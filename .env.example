# MiDashengLM-Gen MCP - environment template
# Copy to .env for local overrides. All variables are optional.

# Backend port for the FastAPI + MCP HTTP surface (fleet registry: 11159)
MIDASHENG_BACKEND_PORT=11159

# Frontend port for the Vite webapp (fleet registry: 11160)
MIDASHENG_FRONTEND_PORT=11160

# Model to load from Hugging Face (transformers trust_remote_code)
MIDASHENG_HF_MODEL_ID=mispeech/midashenglm-gen

# Data directory for SQLite index + generated WAVs (default: <repo>/data)
# MIDASHENG_DATA_DIR=D:/data/midasheng-gen

# Device: auto | cuda | cpu (default: auto - CUDA when available)
MIDASHENG_DEVICE=auto

# Load the model at server startup (1) vs lazy-load on first generate (0)
MIDASHENG_PRELOAD_MODEL=0

# Default generation parameters
MIDASHENG_DEFAULT_CFG=2.0
MIDASHENG_DEFAULT_STOP_THRESHOLD=0.5
MIDASHENG_DEFAULT_SEED=

# Local LLM (Chat page): Ollama endpoint and model
MIDASHENG_OLLAMA_URL=http://127.0.0.1:11434
MIDASHENG_OLLAMA_MODEL=
